[Unit]
Description=Streamly - lecteur IPTV avec transcodage ABR a la demande
After=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=/opt/streamly/server
ExecStart=/usr/bin/python3 /opt/streamly/server/run.py
Restart=always
RestartSec=3

# On borne le CPU pour ne jamais etouffer les autres services de la machine.
# 400% = les 4 coeurs. Un transcodage 4 barreaux a 50 i/s en consomme ~3,5 :
# le brider plus bas fait produire moins vite que le direct, et le lecteur
# se vide. Abaisser cette valeur si la machine heberge d autres services.
CPUQuota=400%

# Durcissement de base
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
